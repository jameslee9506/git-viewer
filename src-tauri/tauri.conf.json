{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Git Viewer",
  "version": "0.1.0",
  "identifier": "dev.local.gitviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Git Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1a1c22",
        "dragDropEnabled": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        },
        "theme": "Dark",
        "acceptFirstMouse": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    },
    "opener": {
      "requireLiteralLeadingDot": false
    }
  }
}
